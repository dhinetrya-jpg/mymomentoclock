# GEMINI_API_KEY: Required for Gemini AI API calls.
# GitHub Actions / Environments automatically injects this from repository secrets.
# Users configure this via Repository Settings -> Secrets and variables -> Actions in GitHub.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Configured in GitHub Pages or container deployment environment.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
