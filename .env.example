# Stateless preview service only. No real payment or private AI capability is activated.
PORT=3000
NODE_ENV=production
# Auth, provider credentials, approved pricing, durable order bindings and explicit privacy consent
# require reviewed integrations. Setting a token alone cannot enable these protected operations.

# PAY-P0-01 specification only: this executable registers no live identity/provider adapters.
# These values alone CANNOT activate public checkout. Never paste secrets into source/chat.
# PAYMENT_DATABASE_URL_FILE=/run/secrets/payment_database_url
# Secret DSN must use postgres://<runtime-role>:<secret>@<private-dns>/<database>?sslmode=verify-full&sslrootcert=/run/secrets/payment_database_ca
# PAYMENT_DB_MAX_OPEN=20
# Future internal listener requires dedicated service CA and cert SAN allowlisting.
# PAYMENT_INTERNAL_URL=https://payment.internal:8443/
# PAYMENT_INTERNAL_CA_FILE=/run/secrets/payment_service_ca
# PAYMENT_INTERNAL_CERT_FILE=/run/secrets/payment_web_certificate
# PAYMENT_INTERNAL_KEY_FILE=/run/secrets/payment_web_key
# Provider namespace is provider/account/environment. Product prices/versions/capabilities
# must be owner-approved server configuration, not illustrative amounts or browser fields.
# Reconciliation is an internal bounded method, no scheduler active in this build.
